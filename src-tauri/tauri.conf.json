{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "VersaTiles Studio",
	"version": "0.0.0",
	"identifier": "org.versatiles.studio",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:1420",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"title": "VersaTiles Studio",
				"width": 1280,
				"height": 800,
				"minWidth": 900,
				"minHeight": 600,
				"dragDropEnabled": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["deb", "appimage", "app", "dmg"],
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
		"resources": ["resources/sprites.tar.gz", "resources/glyphs.tar.gz"]
	}
}
