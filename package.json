{
	"name": "versatiles-studio",
	"private": true,
	"version": "0.2.0",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "npm run build:worker && vite",
		"preview": "vite preview",
		"tauri": "tauri",
		"build": "tsx scripts/run.ts build",
		"build:worker": "tsx scripts/bundle_worker.ts",
		"build:web": "vite build",
		"bundle": "tauri build",
		"bundle-local": "tsx scripts/bundle-local.ts",
		"check": "tsx scripts/run.ts check",
		"check:format": "tsx scripts/run.ts check:format",
		"check:format:web": "prettier --check .",
		"check:format:rust": "cargo fmt --all --check",
		"check:types": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
		"check:lint": "tsx scripts/run.ts check:lint",
		"check:lint:web": "eslint .",
		"check:lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
		"check:lint:docs": "RUSTDOCFLAGS=\"-D warnings\" cargo doc --no-deps --workspace",
		"check:test": "tsx scripts/run.ts check:test",
		"check:test:web": "vitest run",
		"check:test:rust": "cargo test --workspace",
		"fix": "tsx scripts/run.ts fix",
		"fix:format": "tsx scripts/run.ts fix:format",
		"fix:format:web": "prettier --write --log-level warn .",
		"fix:format:rust": "cargo fmt --all",
		"fix:lint": "eslint . --fix",
		"coverage": "tsx scripts/run.ts coverage",
		"coverage:web": "vitest run --coverage --reporter=dot",
		"coverage:rust": "cargo llvm-cov --workspace --lcov --output-path lcov.info && cargo llvm-cov report --summary-only",
		"generate": "tsx scripts/run.ts generate",
		"generate:bindings": "UPDATE_BINDINGS=1 cargo test -p versatiles-studio bindings",
		"release": "tsx scripts/release.ts",
		"assets:fetch": "tsx scripts/fetch-assets.ts",
		"assets:check": "tsx scripts/update-assets.ts",
		"assets:update": "tsx scripts/update-assets.ts --update",
		"e2e": "tsx scripts/run.ts e2e",
		"e2e:build": "tauri build --debug --no-bundle --features e2e",
		"e2e:run": "wdio run wdio.conf.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tauri-apps/cli": "^2.11.4",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.4.0",
		"@vitest/coverage-v8": "^4.1.11",
		"@wdio/cli": "^9.31.4",
		"@wdio/local-runner": "^9.31.4",
		"@wdio/mocha-framework": "^9.31.2",
		"@wdio/native-types": "^2.5.0",
		"@wdio/tauri-service": "^1.3.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.9.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"webdriverio": "^9.31.4"
	},
	"dependencies": {
		"@maplibre/maplibre-gl-style-spec": "26.4.1",
		"@tauri-apps/api": "2.11.1",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"@versatiles/style": "^5.13.1",
		"maplibre-gl": "6.6.0"
	},
	"allowScripts": {
		"esbuild": true,
		"fsevents": true,
		"edgedriver": true,
		"geckodriver": true
	},
	"overrides": {
		"deepmerge-ts": "^8.0.2",
		"serialize-javascript": "^7.1.0",
		"@puppeteer/browsers": "^3.2.1"
	}
}
