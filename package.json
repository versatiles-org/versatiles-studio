{
	"name": "versatiles-studio",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "npm run bundle:worker && vite",
		"build": "npm run bundle:worker && vite build",
		"preview": "vite preview",
		"check": "npm run check:format && npm run check:types && npm run check:lint && npm run check:test && npm run check:rust",
		"check:format": "prettier --check .",
		"check:types": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
		"check:lint": "eslint .",
		"check:test": "vitest run",
		"check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
		"test": "vitest run",
		"tauri": "tauri",
		"format": "prettier --write --log-level warn .",
		"assets:check": "tsx scripts/update-assets.ts",
		"assets:update": "tsx scripts/update-assets.ts --update",
		"assets:fetch": "tsx scripts/fetch-assets.ts",
		"bundle:worker": "tsx scripts/bundle_worker.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^26.2.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.8.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@tauri-apps/api": "2.11.1",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@versatiles/style": "^5.13.1",
		"maplibre-gl": "6.4.1"
	},
	"allowScripts": {
		"esbuild": true,
		"fsevents": true
	}
}
