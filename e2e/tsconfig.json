{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node", "@wdio/globals/types", "@wdio/mocha-framework", "@wdio/native-types"]
	},
	"include": ["**/*.ts", "../wdio.conf.ts"]
}
